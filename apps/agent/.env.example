# Copy to .env. Same LiveKit Cloud project as apps/api/.env. Never commit real values.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Optional; must match LIVEKIT_AGENT_NAME in apps/api if you change it.
# LIVEKIT_AGENT_NAME=voicedesk-support
# Uploads call audio and transcripts to LiveKit Cloud. Off by default; enable only for debugging.
# AGENT_RECORD_SESSIONS=false

# Same value as AGENT_API_KEY in apps/api/.env.
AGENT_API_KEY=""
# Where the agent reaches the VoiceDesk API.
VOICEDESK_API_URL="http://localhost:4000"
