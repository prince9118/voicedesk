# Copy to .env and adjust. .env is gitignored; this file is committed as documentation.
PORT=4000
NODE_ENV=development   # development | test | production (production = raw JSON logs)
LOG_LEVEL=info         # fatal | error | warn | info | debug | trace | silent

# Local Docker database from docker-compose.yml at the repo root.
DATABASE_URL="postgresql://voicedesk:voicedesk@localhost:5432/voicedesk"

# LiveKit Cloud project -> Settings -> API keys. Never commit real values or expose the secret
# to the browser; only LIVEKIT_URL is sent to clients. Verify with: npm run livekit:check
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
