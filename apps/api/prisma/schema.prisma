// Prisma schema: the single source of truth for the database structure.
// Change this file, then run `npx prisma migrate dev --name <change>` to create a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Postgres enums: the database itself rejects any value outside this list.
// Values match the Zod enums in src/tickets/ticket.schema.ts.
enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id            String         @id @default(uuid()) @db.Uuid
  subject       String         @db.VarChar(200)
  description   String
  customerEmail String         @map("customer_email") @db.VarChar(320)
  priority      TicketPriority @default(medium)
  status        TicketStatus   @default(open)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Keyset pagination orders by (createdAt DESC, id DESC). Postgres scans these btrees backwards,
  // so each page is an index seek + LIMIT, regardless of how deep the page is.
  @@index([createdAt, id])
  // Same, within one status (GET /api/tickets?status=open). Most useful when the status is rare.
  @@index([status, createdAt, id])
  @@map("tickets")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // Stored lowercased by the API; the unique constraint is the real guarantee against
  // duplicate accounts, including two registrations racing each other.
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(100)
  // scrypt hash with its parameters (see src/auth/password.ts). Never the password itself.
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

// A logged-in device. The client holds a random token; we store only its SHA-256 hash,
// so a leaked sessions table cannot be used to log in.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  // Deleting a user deletes their sessions, so no orphaned logins survive.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // "Log out everywhere" and per-user session listing look sessions up by user.
  @@index([userId])
  @@map("sessions")
}
