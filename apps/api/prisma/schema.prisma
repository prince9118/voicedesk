// Prisma schema: the single source of truth for the database structure.
// Change this file, then run `npx prisma migrate dev --name <change>` to create a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Postgres enums: the database itself rejects any value outside this list.
// Values match the Zod enums in src/tickets/ticket.schema.ts.
enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

// customer: sees and edits only their own tickets. agent: support staff, sees and triages all.
enum Role {
  customer
  agent
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  // Human-friendly reference ("ticket 1042") for voice and support conversations: a UUID cannot
  // be read out over a call. Generated by a Postgres sequence, so concurrent inserts never collide.
  number      Int            @unique @default(autoincrement())
  subject     String         @db.VarChar(200)
  description String
  priority    TicketPriority @default(medium)
  status      TicketStatus   @default(open)
  // The owner. Restrict: a user with tickets cannot be deleted by accident and take
  // the support history with them.
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Client-supplied Idempotency-Key from the POST that created this ticket. Unique per user, so a
  // retried or duplicated create returns the original ticket instead of making a second one.
  idempotencyKey String?     @map("idempotency_key") @db.VarChar(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  // NULLs never conflict in a Postgres unique index, so tickets created without a key are unaffected.
  @@unique([userId, idempotencyKey])
  // Keyset pagination orders by (createdAt DESC, id DESC). Postgres scans these btrees backwards,
  // so each page is an index seek + LIMIT, regardless of how deep the page is.
  // Agents (all tickets):
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  // Customers (WHERE user_id = me). Also serves as the index for the foreign key.
  @@index([userId, createdAt, id])
  @@map("tickets")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // Stored lowercased by the API; the unique constraint is the real guarantee against
  // duplicate accounts, including two registrations racing each other.
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(100)
  // scrypt hash with its parameters (see src/auth/password.ts). Never the password itself.
  passwordHash String    @map("password_hash")
  // Everyone registers as a customer; agents are promoted out of band (npm run user:set-role).
  role         Role      @default(customer)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  tickets       Ticket[]
  voiceSessions VoiceSession[]

  @@map("users")
}

// Binds a LiveKit room to the user it was created for. The voice agent presents the room name
// (taken from LiveKit's job, never from the LLM) and the API acts as this user: the agent cannot
// choose whose data it accesses.
model VoiceSession {
  id        String   @id @default(uuid()) @db.Uuid
  roomName  String   @unique @map("room_name") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Upper bound on how long the agent may act for the user from this room.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("voice_sessions")
}

// A logged-in device. The client holds a random token; we store only its SHA-256 hash,
// so a leaked sessions table cannot be used to log in.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  // Deleting a user deletes their sessions, so no orphaned logins survive.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // "Log out everywhere" and per-user session listing look sessions up by user.
  @@index([userId])
  @@map("sessions")
}

// Help-center articles, loaded from apps/api/knowledge/*.md by `npm run kb:ingest`.
// contentHash lets ingestion skip unchanged files and detect edits; documents whose file was
// removed are deleted, so the assistant never quotes a stale article.
model KbDocument {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(100)
  title       String    @db.VarChar(200)
  contentHash String    @map("content_hash") @db.Char(64)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  chunks      KbChunk[]

  @@map("kb_documents")
}

// One section of an article: the unit of retrieval. Searched with Postgres full-text search,
// computed at query time; a GIN expression index is the next step if the corpus grows large.
model KbChunk {
  id         String     @id @default(uuid()) @db.Uuid
  documentId String     @map("document_id") @db.Uuid
  document   KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  heading    String     @db.VarChar(200)
  content    String
  position   Int

  @@unique([documentId, position])
  @@map("kb_chunks")
}
