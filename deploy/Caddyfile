# VoiceDesk public entry point. {$DOMAIN} comes from the environment (deploy/.env).
# Caddy obtains and renews a Let's Encrypt certificate for it automatically, and redirects HTTP to
# HTTPS. HTTPS is required: browsers only allow microphone access on secure pages.

{$DOMAIN} {
	encode zstd gzip

	# The API. Caddy sets X-Forwarded-For; the API trusts exactly this one hop (TRUST_PROXY=true).
	handle /api/* {
		reverse_proxy api:4000
	}

	# The React app: static files, falling back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Scripts only from our own origin (the theme script is a file for this reason). Styles allow
		# inline because the animation library sets style attributes. LiveKit needs its wss/https hosts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.livekit.cloud wss://*.livekit.cloud; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Only this site may use the microphone; camera and geolocation are never needed.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# Static assets have content hashes in their names, so they can be cached for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
