# Production configuration for docker-compose.prod.yml. Copy to deploy/.env on the server.
# deploy/.env is gitignored. Never commit real values.

# Public hostname, with an A record pointing at the server's static IP. Example: voicedesk.example.com
DOMAIN=

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=
AGENT_API_KEY=

# LiveKit Cloud project (Settings -> API keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Usage limits (protect the LiveKit credit).
VOICE_SESSIONS_PER_USER_PER_DAY=3
VOICE_SESSIONS_PER_DAY=30
AGENT_MAX_CALL_MINUTES=10
